{
  "entities": {
    "config": {
      "title": "Config",
      "description": "Pengaturan majelis taklim dan kas",
      "properties": {
        "namaMajelis": { "type": "string" },
        "alamatMajelis": { "type": "string" },
        "namaKetua": { "type": "string" },
        "namaBendahara": { "type": "string" },
        "saldoAwal": { "type": "number" },
        "iuranDefault": { "type": "number" },
        "periodeIuran": { "type": "string" }
      },
      "required": ["namaMajelis", "saldoAwal"]
    },
    "transactions": {
      "title": "Transactions",
      "description": "Pencatatan transaksi kas",
      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "jenis": { "type": "string" },
        "kategori": { "type": "string" },
        "nominal": { "type": "number" },
        "keterangan": { "type": "string" },
        "pembayarAtauPenerima": { "type": "string" },
        "metode": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "tanggal", "jenis", "kategori", "nominal"]
    },
    "members": {
      "title": "Members",
      "description": "Master data anggota pengajian",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeAnggota": { "type": "string" },
        "nama": { "type": "string" },
        "jenisKelamin": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "peran": { "type": "string", "enum": ["Jamaah", "Pengurus", "Ustadz / Pengajar", "Remaja Masjid"] },
        "kelompok": { "type": "string" },
        "noHp": { "type": "string" },
        "alamat": { "type": "string" },
        "tanggalBergabung": { "type": "string" },
        "statusAktif": { "type": "string", "enum": ["aktif", "nonaktif"] },
        "catatan": { "type": "string" }
      },
      "required": ["id", "nama"]
    },
    "duesRecords": {
      "title": "DuesRecords",
      "description": "Catatan iuran kas anggota",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "periode": { "type": "string" },
        "tanggalBayar": { "type": "string" },
        "nominal": { "type": "number" },
        "catatan": { "type": "string" }
      },
      "required": ["id", "memberId", "periode", "nominal"]
    },
    "weeklyDuties": {
      "title": "WeeklyDuties",
      "description": "Jadwal tugas pekanan MC, Kultum, dan Khutbah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bulan": { "type": "string" },
        "pekanKe": { "type": "number" },
        "tanggal": { "type": "string" },
        "waktu": { "type": "string" },
        "mc": { "type": "string" },
        "kultum": { "type": "string" },
        "temaKultum": { "type": "string" },
        "khutbah": { "type": "string" },
        "temaKhutbah": { "type": "string" },
        "status": { "type": "string", "enum": ["terjadwal", "selesai", "diganti"] },
        "catatan": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "bulan", "pekanKe", "tanggal", "mc", "kultum", "khutbah", "status"]
    },
    "hafalanRecords": {
      "title": "HafalanRecords",
      "description": "Catatan setoran dan laporan hafalan anggota pengajian",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "namaAnggota": { "type": "string" },
        "tanggal": { "type": "string" },
        "kategori": { "type": "string" },
        "surahAtauMateri": { "type": "string" },
        "juz": { "type": "string" },
        "ayatAtauHalaman": { "type": "string" },
        "predikat": { "type": "string" },
        "statusLulus": { "type": "string", "enum": ["lulus", "proses", "mengulang"] },
        "penyimak": { "type": "string" },
        "catatan": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "namaAnggota", "tanggal", "kategori", "surahAtauMateri", "predikat", "statusLulus", "penyimak"]
    },
    "masterLogins": {
      "title": "MasterLogins",
      "description": "Master data akun login pengurus majelis taklim (tanpa email)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginId": { "type": "string" },
        "namaLengkap": { "type": "string" },
        "peran": { "type": "string", "enum": ["Admin", "Ketua", "Bendahara", "Pengurus"] },
        "statusAktif": { "type": "string", "enum": ["aktif", "nonaktif"] },
        "hasPassword": { "type": "boolean" },
        "catatan": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "loginId", "namaLengkap", "peran", "statusAktif", "createdAt"]
    },
    "loginCredentials": {
      "title": "LoginCredentials",
      "description": "Hash password PBKDF2-SHA256 untuk autentikasi ID & Password",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginDocId": { "type": "string" },
        "loginId": { "type": "string" },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "loginDocId", "loginId", "passwordHash", "passwordSalt", "updatedAt"]
    }
  },
  "firestore": {
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/config" },
      "description": "Konfigurasi utama majelis taklim"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transactions" },
      "description": "Catatan transaksi pemasukan dan pengeluaran kas"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/members" },
      "description": "Master data anggota majelis taklim"
    },
    "/duesRecords/{duesId}": {
      "schema": { "$ref": "#/entities/duesRecords" },
      "description": "Catatan pembayaran iuran anggota"
    },
    "/weeklyDuties/{dutyId}": {
      "schema": { "$ref": "#/entities/weeklyDuties" },
      "description": "Jadwal petugas MC, Kultum, dan Khutbah di setiap pekannya"
    },
    "/hafalanRecords/{hafalanId}": {
      "schema": { "$ref": "#/entities/hafalanRecords" },
      "description": "Catatan setoran dan laporan hafalan anggota"
    },
    "/masterLogins/{loginDocId}": {
      "schema": { "$ref": "#/entities/masterLogins" },
      "description": "Master data akun login ID dan hak akses pengurus"
    },
    "/loginCredentials/{credId}": {
      "schema": { "$ref": "#/entities/loginCredentials" },
      "description": "Penyimpanan hash password terenkripsi per ID Login"
    }
  }
}

